#!/usr/bin/env bash
# TEVV: the one command. Everything else in this repository is how it works.
#
#   ./tevv up | down                       the dashboard (browser entry point)
#   ./tevv stack list | show <id> | check <id>
#                                          who flies a drone, and how (stacks/<id>/interface.py; tevv-default built in)
#   ./tevv stack init <id> [--autopilot simpleflight|px4|ardupilot] [--container <image>]
#                                          a new stack: an interface.py to edit
#   ./tevv test list | show <test>         tests: which stack flies which drone of a scenario (tests/<id>.yaml)
#   ./tevv test init <id> --scenario <s> [--drone <drone>=<stack>]...
#   ./tevv interface <test> [--drone <d>]  what each drone offers its stack: topics, types, rates, the mission
#   ./tevv run <test> [--repeats N]        fly a test (tests/<id>.yaml); `run scenarios/<s>`: tevv-default flies
#   ./tevv watch <test> [--drone <d>]      while it runs: saving interface.py restarts that drone's interface
#   ./tevv logs <test> [--drone <d>] [--container <name>] [-f]
#                                          interface.py's prints, logs and errors (or a stack container's)
#   ./tevv results <test> [--format csv|md] one row per run per mission: ended, verdict, observers
#   ./tevv stop <test>                     stop a running test now
#   ./tevv observers [--json]              the observer types, and what each judges (a drone, a camera, the run, a mission)
#   ./tevv scenario migrate-observers <s> [--dry-run]
#                                          move a scenario's drone checks from its missions onto its drones
#   ./tevv suite list | init <id> --scenarios <s>... | check <id> | results <id> | runs <id> | stop <id>
#   ./tevv suite run <id> [--stack <stack>] a kind of test (local-planner, vio): its scenarios, every drone flown
#                                          by the stack under test (tevv-default without --stack)
#   ./tevv sdk                             the TEVV SDK's source, for your editor (.tevv/sdk)
set -euo pipefail
cd "$(dirname "$0")"
usage() { sed -n '3,24p' "$0" | sed 's/^# \{0,1\}//'; }
cmd="${1:-}"; shift || true
case "$cmd" in
  up)        exec make dashboard "$@" ;;
  down)      exec make dashboard-down ;;
  stack)     exec make --no-print-directory stacks ARGS="stack $*" ;;
  test)      exec make --no-print-directory stacks ARGS="test $*" ;;
  interface) exec make --no-print-directory stacks ARGS="interface $*" ;;
  run)       exec make campaign ARGS="run $*" ;;
  watch)     exec make --no-print-directory stacks ARGS="test watch $*" ;;
  logs)      exec make --no-print-directory stacks ARGS="test logs $*" ;;
  results)   exec make --no-print-directory stacks ARGS="campaign status $*" ;;
  stop)      exec make stacks ARGS="campaign cancel --now $*" ;;
  scenario)  exec make --no-print-directory stacks ARGS="scenario $*" ;;
  observers) image="${METRICS_SERVICE_IMAGE:-$(sed -n 's/^METRICS_SERVICE_IMAGE=//p' .env 2>/dev/null | tail -1)}"
             exec docker run --rm --entrypoint tevv-jsonl-ingest "${image:?set METRICS_SERVICE_IMAGE}" observers "$@" ;;
  suite)     case "${1:-}" in
               run) exec make --no-print-directory suite ARGS="$*" ;;
               *)   exec make --no-print-directory stacks ARGS="suite $*" ;;
             esac ;;
  sdk)       . ./tools/load-images-env.sh
             image="${TEVV_INTERFACE_IMAGE:-$(sed -n 's/^TEVV_INTERFACE_IMAGE=//p' .env 2>/dev/null | tail -1)}"
             [ -n "$image" ] || image="$(sed -n 's/^TEVV_INTERFACE_IMAGE=//p' images/development.generated.env | tail -1)"
             mkdir -p .tevv/sdk
             cid="$(docker create "${image:?no TEVV_INTERFACE_IMAGE pinned}")"
             docker cp "$cid:/opt/mns_component_adaptor/tevv" .tevv/sdk/ >/dev/null && docker rm "$cid" >/dev/null
             echo "TEVV SDK from $image in .tevv/sdk/tevv (point your editor's Python path at .tevv/sdk)" ;;
  ""|-h|--help|help) usage ;;
  *) echo "tevv: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
